# Database
DB_URL=jdbc:postgresql://localhost:5432/task_management_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DRIVER=org.postgresql.Driver
JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# JWT — use a strong random secret in production (min 256 bits)
JWT_SECRET=your_strong_random_secret_key_at_least_32_characters_long

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
