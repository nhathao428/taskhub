# =============================================================================
# ENV cho AWS EC2 all-in-one (IP công khai, HTTP) — copy thành .env trên server
# =============================================================================
#   cp .env.aws.example .env
#   nano .env                       # điền giá trị thật
#   docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d
# =============================================================================

# ─── URL công khai (dùng cho CORS) ──────────────────────────────────────────
# Điền sau khi gán Elastic IP cho EC2, ví dụ: http://3.27.10.55
# Frontend và API cùng origin qua Caddy nên CORS hầu như không bị chạm tới —
# vẫn nên điền đúng IP cho chuẩn.
APP_URL=http://CHANGE_ME_ELASTIC_IP

# ─── Database (bắt buộc) ────────────────────────────────────────────────────
# Mật khẩu mạnh cho postgres. Tạo bằng: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ─── JWT (bắt buộc) ─────────────────────────────────────────────────────────
# Khóa bí mật ≥ 256-bit. Tạo bằng: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_LONG_RANDOM_SECRET

# ─── Tài khoản admin khởi tạo (bắt buộc) ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── Gemini (tùy chọn — bật tính năng AI gợi ý) ─────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
