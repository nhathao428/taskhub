# =============================================================================
# PRODUCTION ENV — copy to .env on the server, fill in real values
# =============================================================================
# Usage on server:
#   cp .env.production.example .env
#   nano .env            # fill in values
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# =============================================================================

# ─── Domain (required) ──────────────────────────────────────────────────────
# Your production domain (no http://, no trailing slash). Caddy auto-issues
# Let's Encrypt cert for this. DNS A record must point to this server first.
DOMAIN=task.example.com

# ─── Database (required) ────────────────────────────────────────────────────
# Strong password for the postgres superuser. Generate with: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ─── JWT (required) ─────────────────────────────────────────────────────────
# 256-bit secret. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_LONG_RANDOM_SECRET

# ─── Admin seed account (required) ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Strong password — used once on first boot to seed the admin user
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── Gemini (optional, enables AI suggestion feature) ──────────────────────
# Leave empty to disable AI suggestions (endpoint returns 422 instead)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
