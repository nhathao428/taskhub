@startuml activity-quan-ly-nhan-vien
!include _style.puml
title Activity Diagram — Quản lý Nhân viên (CRUD)

start
:Quản lý vào trang /employees;
:Frontend gọi GET /api/employees;
:Hiển thị bảng danh sách;

split
  :Xem chi tiết\nnhân viên;
  :GET /api/employees/{id};
  detach
split again
  :Thêm nhân viên mới;
  :Mở modal "+ Thêm";
  :Nhập firstName, lastName,\nposition, department, skills;
  if (form hợp lệ?) then (Yes)
    :POST /api/employees;
    :Validate trùng email;
    if (trùng?) then (Yes)
      :Trả 409\n"Email đã dùng";
      detach
    endif
    :INSERT vào employees;
    :Trả 201 Created;
    :Refresh danh sách;
  else (No)
    :Hiển thị inline error;
    detach
  endif
split again
  :Cập nhật nhân viên;
  :Mở modal "Sửa";
  :Sửa các trường;
  :PUT /api/employees/{id};
  :UPDATE row;
  :Refresh danh sách;
split again
  :Xóa nhân viên;
  :Hỏi xác nhận;
  if (xác nhận?) then (Yes)
    :DELETE /api/employees/{id};
    if (còn task gán?) then (Yes)
      :Trả 409\n"Còn ràng buộc";
      detach
    endif
    :DELETE row;
    :Refresh danh sách;
  endif
end split
stop
@enduml
