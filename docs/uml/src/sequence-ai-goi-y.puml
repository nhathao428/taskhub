@startuml sequence-ai-goi-y
!include _style.puml
title Sequence Diagram — AI Gợi ý Nhân viên

actor "Quản lý" as Mgr
participant "SuggestionController" as SC
participant "AiSuggestionService" as AS
participant "RedisCache" as Cache
database "PostgreSQL" as DB
participant "OpenAI API\n(gpt-4o-mini)" as AI

Mgr -> SC : POST /api/suggestions/recommend\n{taskTitle, taskDescription, requiredSkills}
activate SC
SC -> AS : recommendEmployees(req)
activate AS

AS -> Cache : lookup(cacheKey)
alt cache HIT
  Cache --> AS : Cached List<DTO>
  AS --> SC : List<EmployeeSuggestionDTO>
  SC --> Mgr : 200 OK (cached)
else cache MISS
  Cache --> AS : null
  group batch query song song
    AS -> DB : taskRepo.findByAssignedToIdIn(empIds)
    DB --> AS : List<Task> theo nhân viên
    AS -> DB : attendanceRepo.findInRange(ids, 30d)
    DB --> AS : List<Attendance>
  end
  AS -> AS : collectStats()\n(total/done/late/onTime/workDays)
  AS -> AS : buildPrompt(task + emps + stats)
  AS -> AI : POST /v1/chat/completions
  AI --> AS : JSON [{employeeId, rank, reasoning}]
  AS -> Cache : store(key, result, TTL=5m)
  AS --> SC : List<EmployeeSuggestionDTO>\n(top 5)
  SC --> Mgr : 200 OK\n{data: [...top5...]}
end
deactivate AS
deactivate SC

note over AI
  Backend chỉ gửi số liệu thô,
  AI tự xếp hạng + sinh reasoning
  bằng tiếng Việt. Không có
  rule-based fallback.
end note
@enduml
