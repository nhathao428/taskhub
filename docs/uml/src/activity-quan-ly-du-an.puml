@startuml activity-quan-ly-du-an
!include _style.puml
title Activity Diagram — Quản lý Dự án (CRUD)

start
:Vào trang /projects;
:GET /api/projects;
:Hiển thị bảng danh sách\n(name, description, status,\nstart/end date);

split
  :Tạo dự án mới;
  :Mở modal;
  :Nhập tên, mô tả, ngày bắt đầu,\nngày kết thúc, status=PLANNING;
  :POST /api/projects;
  :INSERT;
  :Refresh;
split again
  :Cập nhật dự án;
  :Mở modal sửa;
  :Sửa các trường;
  :PUT /api/projects/{id};
  :UPDATE;
  :Refresh;
split again
  :Xóa dự án;
  :Hỏi xác nhận;
  if (xác nhận?) then (Yes)
    :DELETE /api/projects/{id};
    if (còn task thuộc dự án?) then (Yes)
      :Trả 409\n"Còn ràng buộc";
      detach
    endif
    :DELETE;
    :Refresh;
  endif
end split
stop
@enduml
