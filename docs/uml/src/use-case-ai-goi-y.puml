@startuml use-case-ai-goi-y
!include _style.puml
title Use Case — AI Gợi ý Nhân viên

left to right direction

actor "Quản lý" as Mgr
actor "Gemini gemini-2.5-flash" as AI <<system>>

rectangle "Module AI Suggestion" {
  usecase "Nhập tiêu đề +\nmô tả công việc" as UC_Input
  usecase "Yêu cầu AI\ngợi ý nhân viên" as UC_Req
  usecase "Hiển thị top 5\nkèm reasoning" as UC_Show
  usecase "Cache kết quả\n(Redis 5 phút)" as UC_Cache
}

Mgr --> UC_Input
Mgr --> UC_Req
Mgr --> UC_Show

UC_Req ..> UC_Cache : <<include>>
UC_Req ..> AI : <<call>>

note right of AI
  Backend xây prompt tiếng Việt rồi gọi
  /v1beta/models/gemini-2.5-flash:generateContent.
  AI tự xếp hạng – KHÔNG có
  rule-based fallback.
end note
@enduml
