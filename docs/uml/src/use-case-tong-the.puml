@startuml use-case-tong-the
!include _style.puml
title Sơ đồ Use Case tổng thể hệ thống Quản lý Công việc

top to bottom direction
skinparam dpi 300
skinparam packageStyle rectangle
skinparam nodesep 14
skinparam ranksep 45

actor "Người dùng (EMPLOYEE)" as User
actor "Quản lý (MANAGER)" as Manager
actor "Quản trị (ADMIN)" as Admin

rectangle "Hệ thống Quản lý Công việc" {
  package "Nghiệp vụ Nhân viên" as P1 {
    usecase "UC-01\nĐăng nhập" as UC01
    usecase "UC-02\nĐăng ký" as UC02
    usecase "UC-03\nĐăng xuất" as UC03
    usecase "UC-06\nXem công việc\ncủa tôi" as UC06
    usecase "UC-07\nCập nhật\ntrạng thái" as UC07
    usecase "UC-09\nChấm công\nvào/ra" as UC09
  }
  package "Nghiệp vụ Quản lý & Quản trị" as P2 {
    usecase "UC-04\nQuản lý nhân viên" as UC04
    usecase "UC-05\nQuản lý dự án" as UC05
    usecase "UC-08\nTạo & gán\ncông việc" as UC08
    usecase "UC-10\nXem báo cáo\nchấm công" as UC10
    usecase "UC-11\nGợi ý nhân viên\nbằng AI" as UC11
    usecase "UC-12\nPhân quyền\ntài khoản" as UC12
    usecase "UC-13\nXem logs\nhệ thống" as UC13
    usecase "UC-14\nQuản lý cấu hình" as UC14
  }
}

User --> UC01
User --> UC02
User --> UC03
User --> UC06
User --> UC07
User --> UC09

Manager --> UC04
Manager --> UC05
Manager --> UC08
Manager --> UC10
Manager --> UC11

Admin --> UC12
Admin --> UC13
Admin --> UC14

User <|-- Manager
Manager <|-- Admin

note bottom of UC11
  Backend gom dữ liệu task + chấm công,
  gọi Gemini (gemini-2.5-flash) xếp hạng top 5.
end note
@enduml
