@startuml architecture
!include _style.puml
title Kiến trúc tổng thể hệ thống

skinparam componentStyle uml2
skinparam linetype ortho

actor "Người dùng" as User

node "Client tier" as ClientTier {
  component "Web Browser\n(React 18 + Vite)" as Web
  component "Mobile App\n(Flutter 3.x)" as Mobile
  component "API consumer\n(Postman, Swagger)" as Tools
}

node "Application tier\n(Docker network: taskmgmt_net)" as AppTier {
  component "Spring Boot 3.5\n(Port 5000)" as Backend {
    [Controller layer]
    [Security (JWT) layer]
    [Service layer]
    [Cache abstraction]
    [Repository (JPA)]
  }
}

node "Data tier" as DataTier {
  database "PostgreSQL 16\n(Port 5432)" as PG
  database "Redis 7\n(Port 6379)" as Redis
}

cloud "OpenAI Chat API\n(gpt-4o-mini)" as OpenAI

User --> Web : HTTPS
User --> Mobile : HTTPS
Web --> Backend : REST + JWT
Mobile --> Backend : REST + JWT
Tools --> Backend : REST + JWT

Backend --> PG : JDBC / HikariCP
Backend --> Redis : RESP / Spring Cache
Backend --> OpenAI : HTTPS / API key

note bottom of Backend
  @PreAuthorize phân quyền 3 role:
  ADMIN > MANAGER > EMPLOYEE.
  Cache key = hash(taskTitle+skills),
  TTL 5 phút cho AI Suggestion.
end note
@enduml
