@startuml architecture
!include _style.puml
title Kiến trúc tổng thể hệ thống

left to right direction
skinparam dpi 200
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 110

actor "Người dùng" as User

rectangle "TẦNG CLIENT" as ClientTier {
  component "Web App\n(React 18 + Vite)\nSong ngữ Việt/Anh (i18n)" as Web
  component "Mobile App\n(Flutter 3.x)" as Mobile
}

rectangle "TẦNG ỨNG DỤNG" as AppTier {
  component "Spring Boot REST API  ·  cổng 5000\n\nController  →  Service  →  Repository\nBảo mật JWT   ·   Spring Cache" as Backend
}

rectangle "TẦNG DỮ LIỆU" as DataTier {
  database "PostgreSQL 16" as PG
  database "Redis 7\n(bộ nhớ đệm)" as Redis
}

cloud "Google Gemini API\n(gemini-2.5-flash)" as Gemini

User --> Web
User --> Mobile
Web --> Backend : REST / JWT
Mobile --> Backend : REST / JWT
Backend --> PG : JDBC
Backend --> Redis : cache
Backend --> Gemini : HTTPS

@enduml
