@startuml activity-cham-cong
!include _style.puml
title Activity Diagram — Chấm công (Check-in / Check-out)

|Nhân viên|
start
:Mở app, vào tab Chấm công;

|Frontend|
:Lấy JWT từ localStorage;
:Gọi GET /api/attendance/me\n(lấy bản ghi hôm nay);

|Backend|
if (đã có bản ghi hôm nay?) then (Yes – đã check-in)
  |Nhân viên|
  if (đã check-out?) then (Yes)
    :Xem kết quả công của ngày;
    stop
  else (Chưa)
    :Nhấn "Check-out";
    |Backend|
    :UPDATE attendances\nSET check_out = NOW()\nWHERE id = ?;
    :Trả 200 OK;
    |Frontend|
    :Hiển thị toast\n"Đã check-out";
    stop
  endif
else (No – chưa check-in)
  |Nhân viên|
  :Nhấn "Check-in";
  |Backend|
  :INSERT (employee_id, date=TODAY,\nstatus=PRESENT, check_in=NOW());
  :Trả 200 OK + ID;
  |Frontend|
  :Hiển thị toast\n"Đã check-in";
  stop
endif
@enduml
