@startuml activity-ai-goi-y
!include _style.puml
title Activity Diagram — AI Gợi ý Nhân viên

|Quản lý|
start
:Vào trang /ai-suggestions;
:Nhập tiêu đề + mô tả công việc\n+ kỹ năng yêu cầu;
:Nhấn "Phân tích bằng AI";

|Frontend|
:POST /api/suggestions/recommend;

|Backend (AiSuggestionService)|
:Hash(taskTitle + skills) = cacheKey;
if (Redis cache HIT?) then (Yes)
  :Lấy List<DTO> từ cache;
else (No)
  partition "Batch query song song" {
    :findAll() từ employees;
    :findByAssignedToIdIn(empIds)\ntừ tasks;
    :findInRange(ids, 30d)\ntừ attendances;
  }
  :collectStats()\n(total/done/onTime/late/workDays);
  :buildPrompt() – tiếng Việt;
  :POST /v1/chat/completions;
  |OpenAI GPT-4o-mini|
  :Phân tích prompt;
  :Trả JSON [{employeeId,\nrank, reasoning}];
  |Backend (AiSuggestionService)|
  :Parse JSON;
  :store(cacheKey, result, TTL=5m);
endif
:Map sang EmployeeSuggestionDTO\n(top 5);

|Frontend|
:Hiển thị 5 thẻ nhân viên\n(huy chương + reasoning);

|Quản lý|
:Đọc lý do, chọn nhân viên\nphù hợp;
stop
@enduml
