@startuml sequence-cham-cong
!include _style.puml
title Sequence Diagram — Chấm công Check-in / Check-out

actor "Nhân viên" as Emp
participant "AttendanceController" as AC
participant "AttendanceService" as AS
participant "JwtFilter" as JF
database "PostgreSQL\n(attendances)" as DB

== Check-in ==
Emp -> AC : POST /api/attendance/me/checkin
activate AC
AC -> JF : verify(JWT)
JF --> AC : userId
AC -> AS : checkIn(employeeId)
activate AS
AS -> DB : SELECT * WHERE\nemployee_id=? AND date=TODAY
alt đã có bản ghi hôm nay
  DB --> AS : Existing row
  AS --> AC : DuplicateException
  AC --> Emp : 409 Conflict\n"Đã chấm công hôm nay"
else chưa chấm
  DB --> AS : empty
  AS -> DB : INSERT (PRESENT, check_in=NOW())
  DB --> AS : id
  AS --> AC : AttendanceDTO
  AC --> Emp : 200 OK\n{attendance}
end
deactivate AS

== Check-out ==
Emp -> AC : POST /api/attendance/me/checkout
AC -> AS : checkOut(employeeId)
activate AS
AS -> DB : SELECT WHERE date=TODAY AND check_out IS NULL
alt chưa check-in
  DB --> AS : empty
  AS --> AC : NotFoundException
  AC --> Emp : 404 Not Found\n"Chưa check-in"
else có bản ghi
  AS -> DB : UPDATE check_out=NOW()
  DB --> AS : updated
  AS --> AC : AttendanceDTO
  AC --> Emp : 200 OK\n{attendance}
end
deactivate AS
deactivate AC
@enduml
