@startuml activity-quan-ly-cong-viec
!include _style.puml
title Activity Diagram — Quản lý Công việc (CRUD + cập nhật trạng thái)

start
:Vào trang /tasks;
:GET /api/tasks (filter theo dự án);
:Hiển thị danh sách;

split
  :[Quản lý] Tạo công việc mới;
  :Modal: title, description,\nrequiredSkills, projectId,\nassignedToId, dueDate, priority;
  :POST /api/tasks (status=pending);
  :INSERT;
  :Refresh;
split again
  :[Quản lý] Sửa / xóa công việc;
  :PUT or DELETE /api/tasks/{id};
  :Refresh;
split again
  :[Nhân viên] Vào /my-tasks;
  :GET /api/tasks/me;
  :Chọn task → đổi status\n(pending → in_progress → completed);
  :PATCH /api/tasks/{id}/status;
  if (Backend kiểm tra ownership?) then (No)
    :Trả 403 Forbidden;
    detach
  endif
  if (status mới = completed?) then (Yes)
    :SET completed_at = NOW();
  endif
  :UPDATE row;
  :Trả 200 OK;
  :Refresh, hiển thị badge mới;
end split
stop
@enduml
