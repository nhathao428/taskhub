' Style chung – tái hiện look StarUML cổ điển:
'   - thân hình chữ nhật / oval / lifeline header màu vàng nhạt #FFFFC8
'   - viền đen #000000, góc vuông (roundCorner 0), không đổ bóng
'   - font Arial 12, mũi tên đen, visibility hiển thị dạng ký tự (- + # ~)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam DefaultFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0

skinparam Class {
  BackgroundColor #FFFFC8
  BorderColor #000000
  HeaderBackgroundColor #FFFFC8
  FontColor #000000
  FontStyle bold
  AttributeFontColor #000000
  AttributeFontSize 11
  StereotypeFontColor #555555
  BorderThickness 1
}

skinparam Entity {
  BackgroundColor #FFFFC8
  BorderColor #000000
  HeaderBackgroundColor #FFFFC8
  FontColor #000000
  FontStyle bold
  AttributeFontColor #000000
  AttributeFontSize 11
}

