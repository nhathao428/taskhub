@startuml use-case-du-an-cong-viec
!include _style.puml
title Use Case — Quản lý Dự án & Công việc

left to right direction

actor "Nhân viên" as Emp
actor "Quản lý" as Mgr

rectangle "Module Dự án & Công việc" {
  package "Dự án" {
    usecase "Xem danh sách\ndự án" as UC_PrjList
    usecase "Tạo dự án" as UC_PrjAdd
    usecase "Cập nhật dự án" as UC_PrjUpd
    usecase "Xóa dự án" as UC_PrjDel
  }
  package "Công việc" {
    usecase "Xem công việc\ncủa tôi" as UC_MyTask
    usecase "Cập nhật trạng thái\ncông việc" as UC_UpdStatus
    usecase "Tạo công việc &\ngán nhân viên" as UC_Create
    usecase "Cập nhật / Xóa\ncông việc" as UC_Edit
  }
}

Emp --> UC_PrjList
Emp --> UC_MyTask
Emp --> UC_UpdStatus

Mgr --> UC_PrjList
Mgr --> UC_PrjAdd
Mgr --> UC_PrjUpd
Mgr --> UC_PrjDel
Mgr --> UC_Create
Mgr --> UC_Edit

UC_Create ..> UC_PrjList : <<include>>

note bottom of UC_UpdStatus
  Backend kiểm tra ownership:
  nhân viên chỉ sửa task của mình.
end note

Mgr -|> Emp
@enduml
