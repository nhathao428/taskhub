# =============================================================================
# FILE CẤU HÌNH MÔI TRƯỜNG - TASK MANAGEMENT SYSTEM
# =============================================================================
# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# BIẾN BẮT BUỘC (docker compose sẽ fail nếu thiếu, do dùng cú pháp ${VAR:?...}):
#   - JWT_SECRET, DB_PASSWORD, ADMIN_PASSWORD
#   - GEMINI_API_KEY chỉ cần khi muốn dùng tính năng AI gợi ý
#
# LƯU Ý:
#   - DB_PASSWORD phải khớp giữa postgres container và backend (compose share cùng biến).
#   - ADMIN_PASSWORD KHÔNG có default — không seed admin nếu thiếu.
#   - JWT_SECRET phải ≥ 32 ký tự (256 bits) — KHÔNG dùng giá trị ví dụ trên production.
#
# Reset database nếu bị password mismatch:
#     docker compose down -v   # xóa volume postgres_data
#     docker compose up -d
# =============================================================================


# -----------------------------------------------------------------------------
# CƠ SỞ DỮ LIỆU (PostgreSQL)
# -----------------------------------------------------------------------------
# JDBC URL kết nối PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/task_management_db

# Tài khoản và mật khẩu database
# QUAN TRỌNG: BẮT BUỘC set DB_PASSWORD (docker compose dùng ${DB_PASSWORD:?...} ở cả
#             postgres container lẫn backend, fail nếu thiếu).
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JDBC driver class (dùng cho PostgreSQL)
DB_DRIVER=org.postgresql.Driver

# Hibernate dialect tương ứng với PostgreSQL
JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect


# -----------------------------------------------------------------------------
# REDIS (Cache)
# -----------------------------------------------------------------------------
# Host và port của Redis server
REDIS_HOST=localhost
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# JWT (Xác thực)
# -----------------------------------------------------------------------------
# Khóa bí mật dùng để ký JWT token — phải đủ dài (ít nhất 256 bits)
# QUAN TRỌNG: Thay bằng chuỗi ngẫu nhiên đủ mạnh trước khi deploy lên production!
JWT_SECRET=your_jwt_secret_key_that_is_at_least_256_bits_long

# Thời gian sống của token (ms). Mặc định 2h = 7,200,000 — giảm rủi ro token bị đánh cắp.
JWT_EXPIRATION_MS=7200000


# -----------------------------------------------------------------------------
# ADMIN ACCOUNT (seed tự động khi khởi động)
# -----------------------------------------------------------------------------
# QUAN TRỌNG: ADMIN_PASSWORD BẮT BUỘC, không có default. Backend sẽ throw nếu rỗng.
# ADMIN_EMAIL: đổi sang email thật (không dùng chung với MANAGER_EMAIL) nếu cần
# nhận thông báo thật (vd reset password) hoặc để tách rõ 2 tài khoản admin/manager.
# Để trống/giữ mặc định vẫn chạy bình thường (chỉ ảnh hưởng seed lúc khởi động lần đầu).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345


# -----------------------------------------------------------------------------
# MANAGER ACCOUNT (tùy chọn — chỉ seed khi MANAGER_PASSWORD được set)
# -----------------------------------------------------------------------------
# Bỏ trống MANAGER_PASSWORD = KHÔNG seed manager. Cách an toàn ở prod: ADMIN tạo
# manager bằng cách đăng ký user thường rồi nâng quyền qua PATCH /api/users/{id}/role.
# MANAGER_EMAIL: nên dùng email thật khác với ADMIN_EMAIL (2 tài khoản riêng biệt).
# MANAGER_USERNAME=manager1
# MANAGER_EMAIL=manager1@example.com
# MANAGER_PASSWORD=


# -----------------------------------------------------------------------------
# GEMINI (Tính năng AI gợi ý nhân viên)
# -----------------------------------------------------------------------------
# API key lấy từ https://aistudio.google.com/apikey (free, không cần thẻ)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# GROQ (fallback tự động khi Gemini bị rate-limit — tùy chọn)
# -----------------------------------------------------------------------------
# Khi Gemini trả 429 (hết hạn mức free ~1.500 req/ngày), backend tự động thử lại qua
# Groq. Free tier Groq cao hơn nhiều (~14.400 req/ngày), không cần thẻ.
# Lấy API key free tại https://console.groq.com/keys
# Để trống = không có fallback, Gemini 429 vẫn trả lỗi cho người dùng như cũ.
GROQ_API_KEY=

# Model Groq sử dụng khi fallback (mặc định: llama-3.3-70b-versatile).
# Có thể đổi sang model khác của Groq, ví dụ: openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile


# -----------------------------------------------------------------------------
# RESEND (gửi email thật cho luồng "quên mật khẩu" — tùy chọn)
# -----------------------------------------------------------------------------
# Lấy API key free tại https://resend.com/api-keys (free tier: 3.000 email/tháng).
# QUAN TRỌNG — free tier CHƯA verify domain riêng: RESEND_FROM bắt buộc phải là
# "... <onboarding@resend.dev>", và Resend CHỈ cho gửi tới đúng email đã dùng đăng ký tài
# khoản Resend (giới hạn sandbox chống spam) — gửi tới email khác sẽ bị Resend từ chối.
# Verify domain riêng tại resend.com/domains rồi đổi RESEND_FROM để gửi được tới bất kỳ ai.
# Để trống RESEND_API_KEY = không gửi email, hệ thống chỉ log (giữ hành vi cũ).
RESEND_API_KEY=

# Địa chỉ gửi — xem giới hạn ở trên trước khi đổi.
RESEND_FROM=TaskHub <onboarding@resend.dev>


# -----------------------------------------------------------------------------
# FRONTEND (Vite / React)
# -----------------------------------------------------------------------------
# URL backend API mà frontend gọi đến
VITE_API_BASE_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# PRODUCTION TUNING (tùy chọn — chỉ đụng khi cần)
# -----------------------------------------------------------------------------
# Hibernate DDL mode: dev/local dùng "update", prod nên dùng "validate" để Hibernate
# không tự ý đổi schema. docker-compose.prod.yml đã hardcode validate.
DDL_AUTO=update

# Bật / tắt Swagger UI. Prod nên tắt để không lộ API surface.
SWAGGER_ENABLED=true

# Rate limit (request/phút/IP)
RATELIMIT_AUTH=20
RATELIMIT_AI=10

# employees + attendance (attendance chứa toạ độ GPS chấm công) — chặn kéo dữ liệu hàng
# loạt nếu 1 tài khoản Manager bị lộ/chiếm. Trước audit tháng 8/2026, 2 nhóm này không có
# rate limit gì cả.
RATELIMIT_EMPLOYEES=40

# Tin tưởng X-Forwarded-For (CHỈ bật khi backend chạy sau reverse proxy đã strip
# header này từ client, vd Caddy/Nginx). Mặc định false để chống IP spoof bypass rate limit.
RATELIMIT_TRUST_FORWARDED=false


# -----------------------------------------------------------------------------
# NHẬN DIỆN KHUÔN MẶT cho check-in (đồ án chuyên ngành — tùy chọn)
# -----------------------------------------------------------------------------
# Để TRỐNG BIOMETRIC_KEY = tắt hoàn toàn tính năng. Check-in bằng GPS vẫn chạy y như cũ,
# client có gửi ảnh cũng bị bỏ qua. Không set thì không cần chạy service Python.
#
# BIOMETRIC_KEY: khoá AES-256 mã hoá embedding khuôn mặt trước khi lưu DB. Tạo bằng:
#     openssl rand -base64 32
# CẢNH BÁO: mất khoá = mất toàn bộ khuôn mặt đã đăng ký, nhân viên phải đăng ký lại.
# Sao lưu khoá riêng, KHÔNG commit lên git.
BIOMETRIC_KEY=

# URL service Python xử lý AI (thư mục ml/face-recognition).
# Chạy service: uvicorn api_service:app --host 127.0.0.1 --port 8000
# LƯU Ý DEPLOY: service này cần ~1-2GB RAM cho PyTorch — KHÔNG vừa free tier 512MB của
# Render. Thực tế chỉ chạy được ở local (đủ cho demo đồ án).
FACE_SERVICE_URL=http://127.0.0.1:8000

# Ngưỡng cosine similarity coi là cùng một người (0-1). Cùng người thường 0.7-1.0,
# khác người thường dưới 0.4-0.5. Chỉnh lại sau khi chạy evaluate.py trên dữ liệu thật:
# ngưỡng cao = khó bị chấm công hộ nhưng dễ từ chối nhầm chính chủ, và ngược lại.
FACE_THRESHOLD=0.65

# Bắt buộc qua kiểm tra chống giả mạo (chớp mắt) mới cho check-in.
# true = client không gửi đủ 3 khung hình sẽ bị đẩy sang PENDING_REVIEW.
FACE_REQUIRE_LIVENESS=true
