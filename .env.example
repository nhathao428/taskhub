# =============================================================================
# FILE CẤU HÌNH MÔI TRƯỜNG - TASK MANAGEMENT SYSTEM
# =============================================================================
# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# LƯU Ý KHI DÙNG DOCKER COMPOSE:
#   Chỉ cần set JWT_SECRET và OPENAI_API_KEY.
#   Các biến DB_* và REDIS_* đã được cấu hình sẵn trong docker-compose.yml.
# =============================================================================


# -----------------------------------------------------------------------------
# CƠ SỞ DỮ LIỆU (PostgreSQL)
# -----------------------------------------------------------------------------
# JDBC URL kết nối PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/task_management_db

# Tài khoản và mật khẩu database
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# JDBC driver class (dùng cho PostgreSQL)
DB_DRIVER=org.postgresql.Driver

# Hibernate dialect tương ứng với PostgreSQL
JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect


# -----------------------------------------------------------------------------
# REDIS (Cache)
# -----------------------------------------------------------------------------
# Host và port của Redis server
REDIS_HOST=localhost
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# JWT (Xác thực)
# -----------------------------------------------------------------------------
# Khóa bí mật dùng để ký JWT token — phải đủ dài (ít nhất 256 bits)
# QUAN TRỌNG: Thay bằng chuỗi ngẫu nhiên đủ mạnh trước khi deploy lên production!
JWT_SECRET=your_jwt_secret_key_that_is_at_least_256_bits_long


# -----------------------------------------------------------------------------
# OPENAI (Tính năng AI gợi ý nhân viên)
# -----------------------------------------------------------------------------
# API key lấy từ https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model OpenAI sử dụng (mặc định: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# FRONTEND (Vite / React)
# -----------------------------------------------------------------------------
# URL backend API mà frontend gọi đến
VITE_API_BASE_URL=http://localhost:5000
